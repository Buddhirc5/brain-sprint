# Copy to .env.local (local dev) and add the VITE_* keys in Vercel → Project → Settings → Environment Variables.
# Never put SUPABASE_SERVICE_ROLE_KEY in any VITE_* variable (it would ship to every visitor's browser).
#
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Your public web address (QR codes, share links, canonical URL, sitemap and social-card image). Strongly recommended for SEO.
VITE_APP_URL=https://antarena.vercel.app
# Set to 1 to force the in-browser demo even when Supabase is configured.
VITE_DEMO=
# Optional: shows a "Contact sales" / "Book a demo" button on the landing page.
VITE_CONTACT_EMAIL=
#
# Optional, local scripts only (not used by the Vite app). Do not add these to Vercel as VITE_*.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# SUPER_ADMIN_EMAIL=you@yourcompany.com
# SUPER_ADMIN_PASSWORD=
